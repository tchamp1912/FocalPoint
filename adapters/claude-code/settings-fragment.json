{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/focalpoint/adapters/hooks.sh",
            "shell": "bash",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
