{
  "description": "FocalPoint Codex session lifecycle integration",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "${HOME}/.config/focalpoint/adapters/codex-hooks.sh", "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "${HOME}/.config/focalpoint/adapters/codex-hooks.sh", "timeout": 5}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "${HOME}/.config/focalpoint/adapters/codex-hooks.sh", "timeout": 5}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "${HOME}/.config/focalpoint/adapters/codex-hooks.sh", "timeout": 5}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "${HOME}/.config/focalpoint/adapters/codex-hooks.sh", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "${HOME}/.config/focalpoint/adapters/codex-hooks.sh", "timeout": 5}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "${HOME}/.config/focalpoint/adapters/codex-hooks.sh", "timeout": 5}]}]
  }
}
